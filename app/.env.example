# --- Otari (hosted gateway, otari.ai) -------------------------------------
# Create a platform token at: otari.ai/organization-settings/api-tokens
# Add a provider key at:       otari.ai/organization-settings/provider-keys
# Leave OTARI_API_KEY unset to run in clearly-labelled MOCK MODE.
OTARI_API_KEY=
# Hosted gateway default. Point at a self-hosted Otari (e.g. http://localhost:8000/v1) if you run one.
OTARI_BASE_URL=https://eu.api.otari.ai/api/v1
# The model panel: comma-separated provider/model deployment strings (Otari routes them all).
OTARI_MODELS=openai/gpt-oss-120b,mistral/mistral-large-latest,mistral/mistral-medium-latest

# --- App -------------------------------------------------------------------
PORT=4173
