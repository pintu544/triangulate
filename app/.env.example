# --- Otari (hosted gateway, otari.ai) -------------------------------------
# Create a platform token at: otari.ai/organization-settings/api-tokens
# Add a provider key at:       otari.ai/organization-settings/provider-keys
# Leave OTARI_AI_TOKEN unset to run in clearly-labelled MOCK MODE.
OTARI_AI_TOKEN=
# Hosted gateway default. Point at a self-hosted Otari (e.g. http://localhost:8000/v1) if you run one.
OTARI_BASE_URL=https://api.otari.ai/v1
# The model panel: comma-separated provider:model strings (Otari routes them all).
OTARI_MODELS=openai:gpt-4o-mini,mistral:mistral-large-latest,openai:gpt-4o

# --- App -------------------------------------------------------------------
PORT=4173
